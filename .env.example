PORT=4000
PUBLIC_API_URL=http://localhost:4000
DATABASE_URL=postgres://dreamtune:dreamtune@localhost:5432/dreamtune

SUPPORT_EMAIL=dreamtuneteam@gmail.com
SMTP_USER=dreamtuneteam@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Public GitHub mode uses a safe mock service. Put the real integration in
# server/private/media.real.service.js and set this to real only on your server.
MEDIA_INTEGRATION_MODE=mock
MEDIA_AUTH_DISABLED=false

SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

VITE_API_URL=http://localhost:4000
VITE_API_TIMEOUT_MS=30000
VITE_YOUTUBE_DOWNLOAD_TIMEOUT_MS=180000
